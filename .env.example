# Copy this file to .env.dev or .env.prod and fill in the values appropriately.
# NEVER commit your actual .env files to version control!

# Postgres settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backtesting
POSTGRES_HOST_PORT=5432

# Engine settings
DATABASE_URL=postgres://postgres:postgres@postgres:5432/backtesting?sslmode=disable
REDIS_URL=redis:6379

# Framework Modes
# Use 'debug' for local development (extra logging) or 'release' for production
GIN_MODE=debug

# API & Services Ports
API_HOST_PORT=8080
COORDINATOR_HOST_PORT=50051
CLIENT_HOST_PORT=5173
CLIENT_PROD_HOST_PORT=80

# Auth
JWT_SECRET=your_jwt_secret

# Kafka settings
KAFKA_BROKERS=kafka:9092
KAFKA_ADVERTISE_HOST=localhost
KAFKA_EXTERNAL_PORT=19092
KAFKA_PROXY_PORT=18082
KAFKA_SCHEMA_PORT=18081
KAFKA_ADMIN_PORT=19644

# Redis settings
REDIS_HOST_PORT=6379

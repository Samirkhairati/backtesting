# Copy this file to .env and adjust. The same file is read by Docker Compose
# (for ${VAR} interpolation) and passed into the containers.
# NEVER commit your real .env.

# ---- Postgres ----
POSTGRES_USER=postgres
# Production: use a strong random password. If it contains URL-special
# characters (@ : / ? # %), percent-encode it inside DATABASE_URL below.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backtesting
# Keep user/password/db in sync with the three values above.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/backtesting?sslmode=disable

# ---- Runtime ----
# 'debug' for local development, 'release' for production
# (the prod compose services force release regardless).
GIN_MODE=debug

# ---- Auth ----
# Production: a random value of at least 32 chars, e.g. `openssl rand -hex 32`.
# Services refuse to start in release mode with a short or placeholder secret.
JWT_SECRET=change-me-dev-only-secret-change-me

# ---- Service discovery (docker network aliases, same in dev and prod) ----
COORDINATOR_ADDR=coordinator:50051
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis:6379
# Where the prod nginx client proxies /api/ to
API_UPSTREAM=api:8080

# ---- CORS ----
# Not needed when using the bundled client (it proxies /api same-origin).
# Set a comma-separated list only if a different origin calls the API,
# e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

# ---- Host port bindings ----
# Postgres, Redis, Kafka and the coordinator bind to 127.0.0.1 by default so
# they are not reachable from outside the host. Set 0.0.0.0 only if you must.
BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8080
CLIENT_HOST_PORT=5173
CLIENT_PROD_HOST_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
COORDINATOR_HOST_PORT=50051

# ---- Kafka (Redpanda) external listener, for tools outside docker ----
KAFKA_ADVERTISE_HOST=localhost
KAFKA_EXTERNAL_PORT=19092
KAFKA_PROXY_PORT=18082
KAFKA_SCHEMA_PORT=18081
KAFKA_ADMIN_PORT=19644

# ---- Redpanda memory ----
# Memory the Kafka broker may use. 1G is comfortable; small hosts (1 GB RAM + swap) can try 300M-400M.
REDPANDA_MEMORY=1G

# ---- Images (CI/CD) ----
# Registry prefix incl. trailing slash, e.g. ghcr.io/<owner>/ ; empty = local build
IMAGE_REGISTRY=
IMAGE_TAG=latest

# Copy this file to .env.dev or .env.prod and fill in the values appropriately.
# NEVER commit your actual .env files to version control!

# Postgres settings
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_database_name

# Engine settings
DATABASE_URL=postgres://your_db_username:your_db_password@postgres:5432/your_database_name?sslmode=disable

# Framework Modes
# Use 'debug' for local development (extra logging) or 'release' for production
GIN_MODE=debug

# Server
API_CONTAINER_PORT=8080
API_HOST_PORT=8080

# Auth
JWT_SECRET=your_jwt_secret

# Kafka
KAFKA_BROKERS=kafka:9092
